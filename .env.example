# Fastly unified API (api.fastly.com) — a Fastly API token sent as the
# Fastly-Key header. The dashboard calls the NGWAF workspace endpoints directly.
FASTLY_API_TOKEN=your-fastly-api-token

# Default customer id the UI opens on. Every API call is scoped to a customer id
# (this default, or whatever is typed into the UI / passed as ?customer_id=).
FASTLY_DEFAULT_CUSTOMER_ID=your-customer-id

# Optional: workspace pre-selected on load (must belong to the default customer).
FASTLY_DEFAULT_WORKSPACE_ID=your-default-workspace-id

# Optional: override the API base (defaults to https://api.fastly.com).
# FASTLY_API_BASE_URL=https://api.fastly.com

# Port for this dashboard's web server
PORT=4000
